APP_ENV=production
LOG_LEVEL=INFO
# Browser origins that will hit this stack (include LAN IP if used, e.g. http://192.168.0.23:8001)
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# External MySQL (not managed by this compose file)
# Use a hostname/IP reachable FROM INSIDE the backend container.
# - MySQL on same Docker host: host.docker.internal
# - Remote MySQL: the real host/IP (e.g. trialnerror.in or 192.168.x.x)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=yoradm
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=yoradm

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@yoradm.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Admin

# Host port published by frontend/nginx
YORADM_PORT=8001
