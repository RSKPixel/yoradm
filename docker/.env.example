APP_ENV=production
LOG_LEVEL=INFO
# Browser origins that will hit this stack (nginx on host port)
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# External MySQL (not managed by this compose file)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=yoradm
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=yoradm

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@yoradm.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Admin

# Host port published by frontend/nginx
YORADM_PORT=8001
